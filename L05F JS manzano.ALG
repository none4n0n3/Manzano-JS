algoritmo "L05F"
// Disciplina: Lógica de Programação
// Autor(a)  : Alexsandra Alves Tarasiuk
// Descrição: Apresentar todos os números divisíveis por 4 menores que 200 (iniciando em 1)
var
   i: inteiro
inicio
   para i de 1 ate 199 faca
      se (i mod 4 = 0) entao
         escreval(i)
      fimse
   fimpara
fimalgoritmo