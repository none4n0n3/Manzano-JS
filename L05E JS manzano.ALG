algoritmo "L05E"
// Disciplina: Lógica de Programação
// Autor(a)  : Alexsandra Alves Tarasiuk
// Descrição: Apresentar os valores numéricos inteiros ímpares situados na faixa de 0 a 20
var
   i: inteiro
inicio
   para i de 0 ate 20 faca
      se (i mod 2 <> 0) entao
         escreval(i)
      fimse
   fimpara
fimalgoritmo